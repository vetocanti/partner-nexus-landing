---
import type { Scene } from '../config/scenes';

interface Props {
  scenes: Scene[];
}
const { scenes } = Astro.props;
---
<nav class="dots" aria-label="Secciones">
  <ol>
    {
      scenes.map((s, i) => (
        <li>
          <a href={`#${s.id}`} data-dot aria-current={i === 0 ? 'step' : undefined}>
            <span class="visually-hidden">{s.eyebrow}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .dots {
    position: fixed;
    top: 50%;
    right: clamp(0.25rem, 1.5vw, 1.5rem);
    z-index: 5;
    transform: translateY(-50%);
  }

  ol {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
  }

  a::before {
    content: "";
    width: 0.4375rem;
    height: 0.4375rem;
    border: 1px solid rgb(243 237 228 / 0.7);
    border-radius: 50%;
    transition: background-color 0.3s, transform 0.3s;
  }

  a:hover::before {
    background: rgb(243 237 228 / 0.5);
  }

  a[aria-current]::before {
    border-color: var(--copper);
    background: var(--copper);
    transform: scale(1.3);
  }
</style>
